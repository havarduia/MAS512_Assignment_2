# Matplotlib style for presentation slides: 16:9 figures, large text, thick lines
# usage: plt.style.use(path to this file)

figure.figsize: 13.33, 7.5
figure.dpi: 100
savefig.dpi: 150
figure.facecolor: fcfcfb
axes.facecolor: fcfcfb
savefig.facecolor: fcfcfb
figure.constrained_layout.use: True

font.size: 20
axes.titlesize: 24
axes.titleweight: bold
axes.labelsize: 20
xtick.labelsize: 18
ytick.labelsize: 18
legend.fontsize: 18
figure.titlesize: 26
figure.titleweight: bold

text.color: 0b0b0b
axes.labelcolor: 0b0b0b
axes.edgecolor: 52514e
xtick.color: 52514e
ytick.color: 52514e
axes.spines.top: False
axes.spines.right: False
axes.grid: True
grid.color: d9d8d4
grid.linewidth: 1.0

lines.linewidth: 3
lines.markersize: 8
axes.prop_cycle: cycler('color', ['2a78d6', 'eb6834', '1baf7a'])

legend.frameon: True
legend.framealpha: 0.9
legend.edgecolor: d9d8d4
